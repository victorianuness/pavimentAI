# =====================================================================
# PavimentAI - Configuração de Ambiente (api/.env)
# =====================================================================

# --- 1) Banco de Dados Principal (usuário de menor privilégio da API) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pavimentai
DB_USER=pavimentai_app
DB_PASSWORD=troque_por_uma_senha_forte_aqui

# --- 2) Banco de Dados Admin (usado apenas pelas rotas /admin/*) ---
# Gere com: python scripts/criar_papel_admin_db.py
DB_ADMIN_USER=pavimentai_admin
DB_ADMIN_PASSWORD=troque_pela_senha_do_admin_db

# --- 3) Segurança e JWT ---
# Gere uma chave segura com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=gere_uma_chave_hexadecimal_com_pelo_menos_32_caracteres_aqui
JWT_EXPIRA_MINUTOS=60
AMBIENTE=dev
MAX_FALHAS_LOGIN=5
BLOQUEIO_LOGIN_MIN=15

# --- 4) Regras Geográficas e Antifraude ---
RAIO_DUPLICIDADE_M=15
LIMITE_OCORRENCIAS_HORA=20
TOLERANCIA_AREA_M=30
DIAS_TROCA_RESIDENCIA=30
JANELA_FOTO_MIN=15
RAIO_FOTO_M=100

# --- 5) CORS e Armazenamento ---
CORS_ORIGENS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
# UPLOADS_DIR=/caminho/opcional/para/disco/persistente
# YOLO_MODEL_PATH=/caminho/opcional/para/best.onnx

# --- 6) Integrações Externas (Opcionais - padrões já configurados) ---
CEP_API_URL=https://viacep.com.br/ws
CEP_TIMEOUT_S=4
IBGE_API_URL=https://servicodados.ibge.gov.br/api
# Token opcional da API v4 do Mapillary para coleta de imagens públicas de ruas (CC-BY-SA)
MAPILLARY_TOKEN=

# --- 7) Servidor de E-mail SMTP (Opcional em dev; obrigatório em prod) ---
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=nao-responda@pavimentai.org.br