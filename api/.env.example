# Copie este arquivo para api/.env e substitua os valores indicados.

# Banco de dados principal
# Em Docker Compose, DB_HOST é sobrescrito para "db".
# Fora do Docker, use localhost.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pavimentai
DB_USER=pavimentai_app
DB_PASSWORD=troque_por_uma_senha_forte_sem_espacos

# Banco de dados admin (opcional; usado pelas rotas /admin/*)
DB_ADMIN_USER=pavimentai_admin
DB_ADMIN_PASSWORD=troque_por_uma_senha_forte_sem_espacos

# Gere um segredo novo com:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=SUBSTITUA_PELA_SAIDA_DE_SECRETS_TOKEN_HEX_32
JWT_EXPIRA_MINUTOS=60
AMBIENTE=dev
MAX_FALHAS_LOGIN=5
BLOQUEIO_LOGIN_MIN=15

# Regras geográficas e antifraude
RAIO_DUPLICIDADE_M=15
LIMITE_OCORRENCIAS_HORA=20
TOLERANCIA_AREA_M=30
DIAS_TROCA_RESIDENCIA=30
JANELA_FOTO_MIN=15
RAIO_FOTO_M=100

# CORS: origens separadas por vírgula
CORS_ORIGENS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Integrações opcionais
CEP_API_URL=https://viacep.com.br/ws
CEP_TIMEOUT_S=4
IBGE_API_URL=https://servicodados.ibge.gov.br/api
MAPILLARY_TOKEN=

# E-mail (opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
SMTP_REMETENTE=nao-responda@pavimentai.org.br

# Opcionais: caminhos absolutos no ambiente onde a API roda
# UPLOADS_DIR=
# YOLO_MODEL_PATH=
